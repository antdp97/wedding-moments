// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// MODELS
// ============================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  events Event[]

  @@map("users")
}

model Event {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  hostId    String   @map("host_id")
  qrCodeUrl String?  @map("qr_code_url")
  settings  Json     @default("{\"autoApprove\": true, \"theme\": \"dark\"}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  host             User              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  photos           Photo[]
  backgroundImages BackgroundImage[]

  @@map("events")
}

model Photo {
  id           String      @id @default(uuid())
  eventId      String      @map("event_id")
  url          String
  thumbnailUrl String?     @map("thumbnail_url")
  senderName   String?     @map("sender_name")
  message      String?
  mimeType     String?     @map("mime_type")
  status       PhotoStatus @default(PENDING)
  isFavorite   Boolean     @default(false) @map("is_favorite")
  createdAt    DateTime    @default(now()) @map("created_at")

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Composite indexes for concurrent query patterns:
  // - groupBy(['status'], { where: { eventId } })  → admin stats
  // - findMany({ where: { eventId, status }, orderBy: { createdAt: 'desc' } }) → Live Wall
  @@index([eventId, status])
  @@index([eventId, status, createdAt])
  @@map("photos")
}

model BackgroundImage {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  url       String
  name      String?
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("background_images")
}
