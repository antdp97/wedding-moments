{
  "name": "wedding-moments",
  "private": true,
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:backend": "turbo run dev --filter=@wedding-moments/backend",
    "dev:frontend": "turbo run dev --filter=@wedding-moments/frontend"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  },
  "engines": {
    "node": ">=22"
  }
}
